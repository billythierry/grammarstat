  stages:
  - name: Keberangkatan Kereta
    background: {fileID: 21300000, guid: 32aa725e35d176e44a68751062dcc0ca, type: 3}
    characters:
    - character: 5
      posX: 0
  lines:
  - speaker: 0
    text: Setelah berbagai aktivitas di Grammar Station berjalan dengan lancar, tibalah
      waktunya bagi kereta untuk melanjutkan perjalanan menuju stasiun berikutnya.
    stage: 0
    showCharacters: 0
  - speaker: 5
    text: Semua tampak siap. Baiklah, saatnya berangkat!
    stage: 0
    showCharacters: 1
  - speaker: 0
    text: Masinis membunyikan peluit. Kereta melaju meninggalkan peron, melewati
      hamparan padang pasir yang gersang.
    stage: 0
    showCharacters: 0
  nextSceneName: Runaway

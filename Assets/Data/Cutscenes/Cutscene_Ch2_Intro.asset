  m_Name: Cutscene_Ch2_Intro
  m_EditorClassIdentifier: 
  stages:
  - name: Area Pemeriksaan Tiket
    background: {fileID: 21300000, guid: eb1bc84756d4c7f4d93554f4870ec5d2, type: 3}
    characters:
    - character: 2
      posX: 0
  lines:
  - speaker: 0
    text: Sementara Thomas sibuk memastikan barang-barang dimuat dengan benar, aktivitas
      lain di Grammar Station terus berjalan. Kereta penumpang yang tiba membawa
      banyak orang yang harus melewati pemeriksaan sebelum melanjutkan perjalanan.
    stage: 0
    showCharacters: 0
  - speaker: 0
    text: Di tengah kesibukan itu, Shelby mulai menjalankan tugasnya di area pemeriksaan
      tiket.
    stage: 0
    showCharacters: 0
  - speaker: 2
    text: Sepertinya hari ini akan cukup sibuk. Banyak sekali penumpang yang harus
      diperiksa.
    stage: 0
    showCharacters: 1
  - speaker: 2
    text: Baiklah, mari kita mulai. Aku harus memastikan semuanya benar sebelum mereka
      naik ke kereta.
    stage: 0
    showCharacters: 1
  nextSceneName: TIcketInspection
